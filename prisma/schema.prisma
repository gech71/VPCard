generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  MAKER
  CHECKER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TermsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(MAKER)
  failedLoginAttempts Int      @default(0)
  lockoutUntil        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  createdRequests    CardRequest[] @relation("MakerRequests")
  assignedRequests   CardRequest[] @relation("CheckerRequests")
  auditLogs          AuditLog[]
  passwordResetTokens PasswordResetToken[]
  emailChangeTokens   EmailChangeToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

/// Verification tokens for the account email-change flow. Stored hashed like
/// password resets, but carrying the requested address, so the account email
/// only moves once the new mailbox has proved it is reachable.
model EmailChangeToken {
  id        String   @id @default(uuid())
  userId    String
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_change_tokens")
}

model CardProgram {
  code             String   @id
  name             String
  bin              String
  prepaidProgram   String?
  enabledForMaker  Boolean  @default(true)
  enabledForSelf   Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requests CardRequest[]

  @@map("card_programs")
}

model CardRequest {
  id              String        @id @default(uuid())
  customerId      String?
  accountNumber   String
  customerName    String
  customerEmail   String?
  customerPhone   String?
  cardProgramCode String?
  cardProgramName String?
  prepaidProgram  String?
  branchCode      String?
  genderCode      String?
  title           String?
  status          RequestStatus @default(PENDING)
  notes           String?
  
  // Checker action
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?

  // PSS Virtual Card Data (encrypted)
  // PAN and expiryDate are encrypted using AES-256-GCM before storage
  // CVV is NEVER stored - it is retrieved from PSS when needed and immediately discarded
  pan             String?
  // CVV removed - PCI DSS prohibits storing CVV after authorization
  expiryDate      String?

  // E-commerce activation - deliberately decoupled from card approval.
  // Approval creates the card at PSS and leaves this false; a checker then
  // activates e-commerce explicitly from the dedicated activation screen.
  ecommerceActivated   Boolean   @default(false)
  ecommerceActivatedAt DateTime?
  ecommerceActivatedBy String?

  // Terms & Conditions accepted when this request was submitted. Recorded per
  // request so the exact wording someone agreed to stays recoverable after the
  // terms are later edited or superseded.
  termsVersionId  String?
  termsVersion    TermsVersion? @relation(fields: [termsVersionId], references: [id])
  termsVersionNo  Int?
  termsAcceptedAt DateTime?

  // Card request fee paid by a Guest before submitting. Null for Maker
  // requests, which never carry a fee, and for Guest requests made while the
  // Super Admin had the fee switched off.
  paymentId       String?             @unique
  payment         CardRequestPayment? @relation(fields: [paymentId], references: [id])

  // Maker who created the request
  makerId         String
  maker           User          @relation("MakerRequests", fields: [makerId], references: [id])
  
  // Checker assigned to review the request
  checkerId       String?
  checker         User?         @relation("CheckerRequests", fields: [checkerId], references: [id])

  cardProgram     CardProgram?  @relation(fields: [cardProgramCode], references: [code])

  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  auditLogs       AuditLog[]

  @@map("card_requests")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  
  // Professional Audit Fields
  actorType     String   @default("USER") // USER, SYSTEM, ADMIN
  actorId       String?  // Unique identifier for the actor
  actorEmail    String?  // Email of the actor for easier search
  targetUserId  String?  // ID of the user being acted upon (if applicable)
  
  action        String
  entityType    String
  entityId      String?
  details       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  cardRequestId String?
  cardRequest   CardRequest? @relation(fields: [cardRequestId], references: [id])

  @@map("audit_logs")
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("settings")
}

/// Versioned Terms & Conditions shown before a card request is submitted.
/// Content is a ProseMirror document, not HTML: the editor schema is the
/// allowlist, so nothing outside the supported nodes and marks can round-trip
/// into a requester browser. Published rows are immutable - changing the terms
/// means publishing a new version, which keeps every acceptance meaningful.
model TermsVersion {
  id          String      @id @default(uuid())
  /// Assigned on publish, so drafts do not consume a number.
  version     Int?        @unique
  title       String
  content     Json
  status      TermsStatus @default(DRAFT)
  createdBy   String?
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  acceptances CardRequest[]

  @@map("terms_versions")
}

/// A Guest card-request fee payment, following steps 3-5 of the NIBtera
/// MiniApp integration. One row per attempt: created PENDING when the payment
/// token is obtained, moved to SUCCESS only once the bank confirms.
///
/// The one-to-one relation to CardRequest is what stops a single payment being
/// spent on more than one request - the unique paymentId on CardRequest makes
/// a second attempt to consume it fail at the database level.
model CardRequestPayment {
  id            String        @id @default(uuid())
  /// Our originator id, sent to the bank and echoed back in the callback.
  transactionId String        @unique
  /// The Guest, identified the same way the rest of the MiniApp identifies
  /// them: the phone number returned by token validation in step 2.
  phoneNumber   String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("ETB")
  status        PaymentStatus @default(PENDING)
  /// Token returned by the bank in step 3, handed to the Super App in step 4.
  paymentToken  String?
  txnRef        String?
  paidAmount    String?
  paidByNumber  String?
  paidAt        DateTime?
  failureReason String?

  cardRequest CardRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phoneNumber, status])
  @@map("card_request_payments")
}

model RevokedToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("revoked_tokens")
}

/// Maps phone numbers and account numbers to a stable PSS customer id.
model CustomerLookup {
  lookupKey   String   @id
  customerId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_lookups")
}

/// ISO numeric currency codes (CUR_IDE) from PSS / reference import
model Currency {
  id           String   @id @default(uuid())
  curIde       String   @unique
  curLabel     String
  curAlphaCode String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("currencies")
}

/// Maps NIB customer IDs to PSS customer IDs
model CustomerIdMapping {
  id        String   @id @default(uuid())
  nibCusId  String
  pssCusId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nibCusId, pssCusId])
  @@map("customer_id_mappings")
}
/// One-time codes proving a Guest controls the email address they put on a
/// card request.
///
/// A Guest is not a User row - the MiniApp identifies them by the phone number
/// its token resolves to - so verification is keyed on that phone number and
/// bound to the exact address that was challenged. Changing the address means
/// starting again, which is the whole point of the check.
model EmailVerification {
  id          String    @id @default(uuid())
  phoneNumber String
  email       String
  /// HMAC of the six-digit code, keyed with the server secret. A plain hash of
  /// six digits is trivially reversible from a database dump; an HMAC is not,
  /// without the key.
  codeHash    String
  expiresAt   DateTime
  /// Wrong guesses so far. The code dies once this hits the attempt limit, so
  /// the million-code space cannot be walked.
  attempts    Int       @default(0)
  /// When the correct code was entered.
  verifiedAt  DateTime?
  /// When a card request was actually submitted against it. Set once, so one
  /// verification cannot authorise a second request.
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber, email])
  @@index([createdAt])
  @@map("email_verifications")
}
